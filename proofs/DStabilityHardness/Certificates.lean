  exact (add_nonneg (add_nonneg (add_nonneg (add_nonneg (add_nonneg (add_nonneg (add_nonneg (add_nonneg (add_nonneg (Psi2H0_nonneg u s t w A B C hu hs ht hw hA hB hC) (Psi2H1_nonneg u s t w A B C hu hs ht hw hA hB hC)) (Psi2H2_nonneg u s t w A B C hu hs ht hw hA hB hC)) (Psi2H3_nonneg u s t w A B C hu hs ht hw hA hB hC)) (Psi2H4_nonneg u s t w A B C hu hs ht hw hA hB hC)) (Psi2H5_nonneg u s t w A B C hu hs ht hw hA hB hC)) (Psi2H6_nonneg u s t w A B C hu hs ht hw hA hB hC)) (Psi2H7_nonneg u s t w A B C hu hs ht hw hA hB hC)) (Psi2H8_nonneg u s t w A B C hu hs ht hw hA hB hC)) (Psi2H9_nonneg u s t w A B C hu hs ht hw hA hB hC))

theorem Psi2_ordered_nonneg (ρ h A B C : ℝ) (hρ0 : 17 / 10 ≤ ρ) (hρ1 : ρ ≤ 7 / 4)
    (hh0 : 3 ≤ h) (hh1 : h ≤ 5) (hA : 0 ≤ A) (hB : 0 ≤ B) (hC : 0 ≤ C) :
    0 ≤ Psi2 ρ h (A + B + C) (B + C) C := by
  have hρ : ρ = (34 + (20 * ρ - 34)) / 20 := by ring
  have hh : h = 3 + 2 * ((h - 3) / 2) := by ring
  rw [hρ, hh, Psi2H_identity]
  exact Psi2H_nonneg _ _ _ _ A B C (by linarith) (by linarith) (by linarith) (by linarith) hA hB hC

